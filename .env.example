# ──────────────────────────────────────────────────────────────
# Supabase configuration (OPTIONAL for local dev)
# The app runs fully with MOCKED submissions if these are absent.
# Copy this file to ".env.local" and fill in real values to enable
# live RSVP persistence.
# ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (no trailing slash). Used as metadataBase so social link
# previews (WhatsApp/iMessage/Twitter) resolve the OG image to an absolute URL.
# Set this in Vercel to your real domain, e.g. https://ruthanderic.wedding
NEXT_PUBLIC_SITE_URL=

# Optional: simple shared password gate for the /admin route (future use)
# NEXT_PUBLIC_ADMIN_PASSWORD=
